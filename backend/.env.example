# Copy to .env (or set these in your service manager) for production.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=pms.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://pms.example.com
DJANGO_SECURE_COOKIES=true
DJANGO_TIME_ZONE=Africa/Dar_es_Salaam

# PostgreSQL (pip install "psycopg[binary]"). Leave unset to use SQLite.
DB_ENGINE=django.db.backends.postgresql
DB_NAME=pms
DB_USER=pms
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=5432
